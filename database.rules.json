{
  "rules": {
    "lera_diary_v1": {
      "$uid": {
        ".read": "auth.uid === $uid || root.child('lera_diary_users').child(auth.uid).child('role').val() === 'reader' && root.child('lera_diary_users').child(auth.uid).child('ownerUid').val() === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "lera_finance_v1": {
      "$uid": {
        ".read": "auth.uid === $uid || root.child('lera_diary_users').child(auth.uid).child('role').val() === 'reader' && root.child('lera_diary_users').child(auth.uid).child('ownerUid').val() === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "lera_diary_users": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    }
  }
}